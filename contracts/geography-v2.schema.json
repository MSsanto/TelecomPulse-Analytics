{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://telecompulse.local/contracts/geography-v2.schema.json",
  "title": "TelecomPulse State Geography Contract v2",
  "type": "object",
  "required": [
    "geography_type",
    "country_code",
    "country_name",
    "region_code",
    "region_name",
    "ibge_region_code",
    "state_code",
    "state_name",
    "ibge_state_code"
  ],
  "properties": {
    "geography_type": { "const": "state" },
    "country_code": { "const": "BR" },
    "country_name": { "const": "Brasil" },
    "region_code": {
      "type": "string",
      "enum": ["N", "NE", "CO", "SE", "S"]
    },
    "region_name": {
      "type": "string",
      "enum": ["Norte", "Nordeste", "Centro-Oeste", "Sudeste", "Sul"]
    },
    "ibge_region_code": {
      "type": "string",
      "enum": ["1", "2", "3", "4", "5"]
    },
    "state_code": {
      "type": "string",
      "enum": [
        "AC", "AL", "AP", "AM", "BA", "CE", "DF", "ES", "GO",
        "MA", "MT", "MS", "MG", "PA", "PB", "PR", "PE", "PI",
        "RJ", "RN", "RS", "RO", "RR", "SC", "SP", "SE", "TO"
      ]
    },
    "state_name": {
      "type": "string",
      "minLength": 2
    },
    "ibge_state_code": {
      "type": "string",
      "enum": [
        "11", "12", "13", "14", "15", "16", "17",
        "21", "22", "23", "24", "25", "26", "27", "28", "29",
        "31", "32", "33", "35",
        "41", "42", "43",
        "50", "51", "52", "53"
      ]
    }
  },
  "additionalProperties": false
}
