{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://telecompulse.local/contracts/geography-v2.schema.json",
  "title": "TelecomPulse Geography Contract v2",
  "type": "object",
  "required": ["country_code", "country_name", "region_code", "region_name", "state_code", "state_name", "ibge_state_code"],
  "properties": {
    "country_code": { "const": "BR" },
    "country_name": { "const": "Brasil" },
    "region_code": {
      "type": "string",
      "enum": ["N", "NE", "CO", "SE", "S"]
    },
    "region_name": {
      "type": "string",
      "enum": ["Norte", "Nordeste", "Centro-Oeste", "Sudeste", "Sul"]
    },
    "state_code": {
      "type": "string",
      "pattern": "^[A-Z]{2}$"
    },
    "state_name": {
      "type": "string",
      "minLength": 2
    },
    "ibge_state_code": {
      "type": "string",
      "pattern": "^[0-9]{2}$"
    }
  },
  "additionalProperties": false
}
